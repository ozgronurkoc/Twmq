modules = ["python-3.10"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "pkg-config", "xsimd"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "spor-toto"

[[workflows.workflow]]
name = "spor-toto"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "spor-toto --picks \"1,10,1,12,0,10,2,10,1,12,02,1,10,2,10\""

[workflows.workflow.metadata]
outputType = "console"
