run = "bash scripts/run_next_dev.sh"
# Node surumu CI ve `frontend/package.json` engines ile hizali olmali;
# once burada 24, CI'da 22 yaziyordu ve ikisi hicbir yerde
# karsilastirilmiyordu.
modules = ["python-3.10", "nodejs-22"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "pkg-config", "xsimd"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Lab"

# UI + API birlikte — Run dugmesi burayi acar (preview :3000)
[[workflows.workflow]]
name = "Start Lab"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run_next_dev.sh"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

# Yalnizca Flask API (UI olmadan; /api/* uclari)
[[workflows.workflow]]
name = "API only"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/setup.sh && python backend/web_app.py"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"

# Bagimliliklari kur (git pull sonrasi tek tikla)
[[workflows.workflow]]
name = "Kurulum"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/setup.sh"

[workflows.workflow.metadata]
outputType = "console"

# Hizli test suiti (ILP testleri haric)
[[workflows.workflow]]
name = "Testler"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python -m pytest -m \"not slow\" -q"

[workflows.workflow.metadata]
outputType = "console"

# Degismez (invariant) kontrolleri — /saglik sayfasinin konsol karsiligi
[[workflows.workflow]]
name = "Saglik"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python -m spor_toto.health"

[workflows.workflow.metadata]
outputType = "console"

# CLI ornegi (arayuzsuz formul uretimi)
[[workflows.workflow]]
name = "spor-toto"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python -m spor_toto.cli --picks \"1,10,1,12,0,10,2,10,1,12,02,1,10,2,10\""

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/build.sh"]
run = ["bash", "scripts/run_prod.sh"]
