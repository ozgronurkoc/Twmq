# Aracin urettigi kupon ciktilari
formul.txt
*.kupon.txt

# Oran arsivi: ham kaynak dosyalar ve SQLite kopyasi uretilir,
# surumlenmez. Yeniden olusturmak icin: python scripts/build_odds.py
backend/data/odds/_kaynak/
backend/data/odds/odds.sqlite3
# Sezon basina uretilen kopyalar (build_odds.py --sezon)
backend/data/odds/odds_*.sqlite3

# Iddaa bulten arsivi: tarih damgali CSV'ler SURUMLENIR (arsivin kendisi
# odur), ham payload ve SQLite kopyasi uretilir. Yeniden olusturmak icin:
# python scripts/snapshot_iddaa.py
backend/data/iddaa/_kaynak/
backend/data/iddaa/iddaa.sqlite3

# Egitim korpusu: turetilmis CSV + rapor SURUMLENIR, ham lig dosyalari
# uretilir. Bu korpus TAHMIN katmanina aittir; istatistik sayfasinin verisi
# degildir. Yeniden olusturmak icin: python scripts/build_egitim.py
backend/data/egitim/_kaynak/

# Uretilmis Super Toto sayfalari (`scripts/super_toto_sayfa.py`).
# Depodaki kopya olculdu ve ZATEN BAYATTI: `shin` arindirmasina gecisten
# once uretilmis sayilarla duruyordu ve hicbir kapi bunu goremiyordu.
# Ham/uretilmis ciktiyi versiyonlamama kurali diger butun boru hatlarinda
# zaten uygulaniyor (odds, iddaa, egitim `_kaynak/`); bu tek istisnaydi.
backend/data/super_toto/**/*.html

# Egitilmis model artefaktlari (`python -m spor_toto.artefakt --yaz`).
# Turetilmis cikti: korpustan uretilir, SURUMLENMEZ. Bayat kalirsa
# `python -m spor_toto.health` kirmizi gosterir.
backend/data/artefakt/

# Avrupa fiksturu ve sehir tablosu: TURETILMIS CSV + rapor SURUMLENIR
# (kaynak GitHub'da ve zamanla degisebilir; olculen sayilar bu dosyalara
# dayaniyor), ham kaynak kopyasi uretilir. Yeniden olusturmak icin:
# python scripts/build_avrupa.py · python scripts/build_sehir.py
backend/data/avrupa/_kaynak/

# Olcum kosum defteri (`--kaydet`). Yerel bir defterdir: bir sayiyi
# savunmak gerektiginde bakilir, paylasilmaz. Surumlenseydi her olcum
# depoyu buyutur ve depo bir veri ambarina donerdi.
backend/data/kosumlar/

# StatsBomb (hudl/open-data) mac ozetleri. Iki ayri sebeple git disi:
#
# 1. LISANS. "StatsBomb Public Data User Agreement" md. 1.2.1 veriyi
#    "distribute, reproduce ... to any external or third party" etmeyi
#    yasaklar ve bu depo public'tir. Depoya yalnizca KATSAYI ve RAPOR
#    girer (`data/xg/xg_kalibrasyon.json`, `xg_rapor.json`) — bunlar
#    lisansin serbest biraktigi "analysis or conclusions"tir.
# 2. BOYUT. Ham olay dosyalari 1.517 mac icin ~5,2 GB. `build_xg.py`
#    onlari diske hic yazmaz; burada onbelleklenen sey maç basina dort
#    sayilik ozettir ve yalnizca ~25 dakikalik indirmeyi yeniden
#    baslatilabilir kilar.
#
# Yeniden olusturmak icin: python scripts/build_xg.py
backend/data/xg/_kaynak/

# Resmi Spor Toto arsivi (§6D): sezon JSON'lari ve rapor SURUMLENIR,
# indirilen ham payload git disidir — tek komutla yeniden uretilir.
backend/data/sportoto_arsiv/_kaynak/

# Bulten OCR (§6F): sezon JSON'lari ve rapor SURUMLENIR, indirilen gorseller
# git disidir. Gorseller ~170 adet ve toplam onlarca MB; ciktisi metin.
backend/data/bulten/_kaynak/

# Gecmis sezon birlestirmesi (§6G): indirilen football-data CSV'leri git disi,
# tek komutla yeniden iner.
backend/data/st_history/_kaynak/
