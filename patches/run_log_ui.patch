+
+  function copyRunLog(){
+    const el=document.getElementById('runLogText'); if(!el) return;
+    const text=el.value;
+    const done=()=>{ const btn=document.getElementById('logCopyBtn'); if(!btn) return;
+      btn.textContent='Kopyalandı'; btn.classList.add('copied');
+      setTimeout(()=>{ btn.textContent='Logu Kopyala'; btn.classList.remove('copied'); },1600); };
+    if(navigator.clipboard&&navigator.clipboard.writeText){
+      navigator.clipboard.writeText(text).then(done).catch(()=>{ el.select(); document.execCommand('copy'); done(); });
+    } else { el.select(); document.execCommand('copy'); done(); }
+  }
